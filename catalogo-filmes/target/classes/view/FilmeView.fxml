<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10" prefWidth="700" prefHeight="500"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.FilmeController">
    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <GridPane hgap="10" vgap="8">
        <Label text="Título:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="txtTitulo" prefWidth="300" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Diretor:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="txtDiretor" prefWidth="300" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Ano:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="txtAno" prefWidth="100" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Nota (0 a 10):" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="txtNota" prefWidth="100" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="Gênero:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <ComboBox fx:id="cmbGenero" prefWidth="300" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
    </GridPane>

    <HBox spacing="10">
        <Button text="Inserir" onAction="#inserir"/>
        <Button text="Atualizar" onAction="#atualizar"/>
        <Button text="Excluir" onAction="#excluir"/>
        <Button text="Limpar" onAction="#limpar"/>
    </HBox>

    <TableView fx:id="tabela" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
            <TableColumn fx:id="colTitulo" text="Título" prefWidth="220"/>
            <TableColumn fx:id="colDiretor" text="Diretor" prefWidth="140"/>
            <TableColumn fx:id="colAno" text="Ano" prefWidth="60"/>
            <TableColumn fx:id="colNota" text="Nota" prefWidth="60"/>
            <TableColumn fx:id="colGenero" text="Gênero" prefWidth="130"/>
        </columns>
    </TableView>
</VBox>
